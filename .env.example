# Copy to .env. Never include this file's real values in the Android app or commit .env.
# Use an HTTPS reverse proxy for phone access. Only bind 0.0.0.0 behind that proxy.
HOST=127.0.0.1
PORT=8787
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=https://YOUR-DOMAIN/oauth/callback
# Generate separately with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
PAIR_TOKEN=
# Optional: exact HTTPS origin if using a separate browser preview origin. No wildcard.
APP_ORIGIN=
